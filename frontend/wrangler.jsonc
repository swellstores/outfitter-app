{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Generic on purpose: this worker is not tied to any one store. The store it
  // serves comes from the `swell-*` headers on each request.
  "name": "outfitter",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // The page cache is keyed by deploy: each version gets a fresh epoch, so a
  // release never serves the previous build's HTML. The cache itself is the
  // Workers Cache API — no KV namespace, so nothing to provision per store.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // Named environments for `wrangler deploy --env preview|production`. They are
  // empty because everything above is inherited, and there is nothing
  // per-environment to override. Set HTML_CACHE_TTL (seconds, 0 to disable) or
  // HTML_CACHE=false in `vars` here to override the merchant's cache setting.
  "env": {
    "preview": {},
    "production": {}
  }
}
