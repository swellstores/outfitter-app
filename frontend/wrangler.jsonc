{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Generic on purpose: this worker is not tied to any one store. The store it
  // serves comes from the `swell-*` headers on each request.
  "name": "outfitter",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // The page cache is keyed by deploy: each version gets a fresh epoch, so a
  // release never serves the previous build's HTML.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Where the page cache lives: one KV store for every data center. The proxy
  // reaches this worker through several, and the Workers Cache API keeps one
  // cache per data center, so most requests missed. A deployment without this
  // binding falls back to the Cache API.
  "kv_namespaces": [
    {
      "binding": "NAMESPACE",
      "id": "93f0baa44526426e88d3de3703185684"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // Named environments for `wrangler deploy --env preview|production`. Bindings
  // are not inherited, so each repeats the page cache's; everything else above
  // is. Set HTML_CACHE_TTL (seconds, 0 to disable) or HTML_CACHE=false in `vars`
  // here to override the merchant's cache setting.
  "env": {
    "preview": {
      "kv_namespaces": [{ "binding": "NAMESPACE", "id": "93f0baa44526426e88d3de3703185684" }]
    },
    "production": {
      "kv_namespaces": [{ "binding": "NAMESPACE", "id": "93f0baa44526426e88d3de3703185684" }]
    }
  }
}
