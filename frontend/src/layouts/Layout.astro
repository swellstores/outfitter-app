  /* Language and currency: header chrome, not a form field, so the controls
     take the nav's size and face. Beats `select.input` on specificity. */
  .loc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .loc .input {
    width: auto;
    max-width: 11rem;
    min-height: 36px;
    padding: 0 1.5rem 0 0.625rem;
    background-position: right 0.5rem center;
    font-family: var(--font-mono);
    font-size: var(--text-chrome);
    font-weight: 500;
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
  }

  /* Below this the end column cannot hold the links and the language and
     currency control side by side, so the control gets a row of its own
     beneath them — full width, so a long store name is not squeezed to make
     room for it. Only the first row is declared: without the control there
     is no second row, and no gap. */
  @media (max-width: 899px) {
    .site-header__inner {
      grid-template-rows: var(--header-h);
    }

    .site-header__end {
      display: contents;
    }

    .loc {
      grid-column: 1 / -1;
      flex-wrap: wrap;
      justify-content: flex-end;
      padding-bottom: 0.625rem;
    }
  }

  @media (max-width: 599px) {
    .site-header__inner {
      grid-template-columns: auto 1fr;
      gap: 0.75rem;
    }

    /* 1rem: anything smaller makes iOS zoom on focus. */
    .loc .input {
      font-size: 1rem;
    }

    /* The centred wordmark cannot hold at this width, so it moves left and
       the shop link folds into it. */
    .nav--start {
      display: none;
    }

    .brand {
      justify-self: start;
      order: -1;
      min-width: 0;
    }

    /* A long store name takes a second line here rather than losing its end. */
    .brand__name {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-height: 1.35;
      white-space: normal;
    }

    .nav {
      gap: 1rem;
    }
  }

  /* Main, footer ------------------------------------------------------ */

  .site-main {
    flex: 1;
    padding-bottom: 7.5rem;
  }

  .site-main:not([data-flush]) {
    padding-top: 3rem;
  }

  @media (max-width: 767px) {
    .site-main {
      padding-bottom: 4rem;
    }

    .site-main:not([data-flush]) {
      padding-top: 2rem;
    }
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .site-footer__mark,
  /* Said plainly rather than quietly: the point is that nobody mistakes the
     store for one that ships. Full width, so it never reads as a footer link. */
  .site-footer__demo {
    flex-basis: 100%;
    order: -1;
    padding-bottom: 1rem;
    color: var(--color-text);
  }

  .site-footer__legal {
