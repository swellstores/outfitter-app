---
import { tenantKey } from '@/swell';
import { getAppSettings } from '@/lib/app-settings';
import { isLightColor, safeColor } from '@/lib/color';
import { localizationOptions } from '@/lib/localization';
import { keyedSearch } from '@/lib/cacheable';
import EditClient from '@/components/EditClient.astro';
import T from '@/components/T.astro';

interface Props {
  title?: string;
  description?: string;
  /** The picture a shared link shows — a product's photo. */
  image?: string;
  /** Full-bleed pages opt out of the default page top padding. */
  flush?: boolean;
}

const FAVICON =
  'data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2032%2032%22%3E%3Crect%20width=%2232%22%20height=%2232%22%20rx=%227%22%20fill=%22%23111111%22%20/%3E%3Cpath%0A%20%20%20%20d=%22M11%2011h10M11%2016h10M11%2021h6%22%0A%20%20%20%20stroke=%22%23ffffff%22%0A%20%20%20%20stroke-width=%222.5%22%0A%20%20%20%20stroke-linecap=%22round%22%0A%20%20/%3E%3C/svg%3E';

const { title, description, image, flush } = Astro.props;
const { swell, settings, t, editMode, editLocale } = Astro.locals;

const app = await getAppSettings(swell, tenantKey(Astro));

// Pages are cached and shared between visitors, so nothing per-visitor is
// rendered here. The cart count and drawer hydrate client-side from /cart.json;
// the client only needs to know how to format money.
const { currency, locale } = swell.getStorefrontLocalization();

// Settings → General names the store; the app setting overrides it for
// merchants whose shopfront goes by something else.
const storeNameOverride =
  typeof app.store_name === 'string' ? app.store_name.trim() : '';
const storeName: string =
  storeNameOverride || settings?.state?.store?.name || 'Outfitter';
const logo = typeof app.logo === 'string' ? app.logo : app.logo?.url;

// The language and currency control, only when there is a choice to make.
// It posts to /localization and comes back here: the query string comes too,
// so an editing render (`__edit`) stays one after the switch.
const store = settings?.state?.store;
const locales = localizationOptions(store?.locale, store?.locales);
const currencies = localizationOptions(store?.currency, store?.currencies);
const localization = locales.length > 1 || currencies.length > 1;
const here = `${Astro.url.pathname}${keyedSearch(Astro.url)}`;

// support_email is not ours to ask for — Swell already collects one in the
// store's own settings, so the footer sources it there or shows nothing.
const supportEmail =
  typeof settings?.state?.store?.support_email === 'string'
    ? settings.state.store.support_email.trim()
    : '';

const pageTitle = title ? `${title} — ${storeName}` : storeName;

// Every token has a default in the :root block below, so the palette is only
// overridden for the values the merchant actually set and that parse cleanly.
const tokens = styleFor({
  '--color-primary': app.color_primary,
  '--color-secondary': app.color_secondary,
  '--color-text': app.color_text,
  '--color-muted': app.color_muted,
  '--color-background': app.color_background,
  '--color-surface': app.color_surface,
  '--color-border': app.color_border,
});

// Scrollbars, select menus and autofill are the browser's to draw, and it
// draws them dark until the page says otherwise. A merchant who sets a light
// background gets light ones; anything we cannot read keeps the dark default.
const scheme = isLightColor(app.color_background);

// The chevron is a background image, which is isolated from the page and so
// cannot read a custom property or `currentColor`. Painting it here is the
// only way it follows the merchant's muted colour instead of the default's.
const chevron = selectChevron(app.color_muted);

const palette =
  [tokens, scheme === true ? 'color-scheme:light' : undefined, chevron]
    .filter(Boolean)
    .join(';') || undefined;

/**
 * The select chevron, drawn in `color`. Every character that would need
 * quoting inside `url()` is percent-encoded, so the declaration carries no
 * quotes, parentheses or spaces of its own and survives the style attribute.
 */
function selectChevron(value: unknown): string | undefined {
  const color = safeColor(value);

  if (!color) {
    return undefined;
  }

  const svg =
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 6">` +
    `<path d="M1 1l4 4 4-4" fill="none" stroke="${color}" stroke-width="1.2"/>` +
    `</svg>`;

  return `--select-chevron:url(data:image/svg+xml,${encodeURIComponent(svg)})`;
}

// Only literal colors reach the style attribute below; see lib/color.ts.
function styleFor(tokens: Record<string, unknown>): string | undefined {
  const declarations = Object.entries(tokens)
    .map(([name, value]) => [name, safeColor(value)])
    .filter(([, value]) => value)
    .map(([name, value]) => `${name}:${value}`);

  return declarations.length > 0 ? declarations.join(';') : undefined;
}
---

<html
  lang="en"
  style={palette}
  data-currency={currency}
  data-locale={locale}
  data-edit-locale={editMode ? editLocale : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {/* Inline: a request for /favicon.svg would cross the proxy like any page. */}
    <link rel="icon" type="image/svg+xml" href={FAVICON} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* What a link pasted into chat or social shows. */}
    <meta property="og:site_name" content={storeName} />
    <meta property="og:title" content={title || storeName} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* media="print" keeps the font off the render path; the script below
        promotes it once it has loaded. The fallback stack is a real one, so
        nothing on the page ever waits for the network. */}
    <link
      id="webfont"
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
    />
    <script is:inline>
      (function () {
        var el = document.getElementById('webfont');
        if (!el) return;
        if (el.sheet) {
          el.media = 'all';
          return;
        }
        el.addEventListener('load', function () {
          el.media = 'all';
        });
      })();
    </script>
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>
  </head>

  <body>
    <a class="skip-link" href="#main"><T id="global_skip_link" /></a>

    <header class="site-header">
      <div class="container site-header__inner">
        <nav class="nav nav--start" aria-label={t('global_nav_main_label')}>
          <a class="nav__link" href="/"><T id="global_nav_shop" /></a>
        </nav>

        <a class="brand" href="/">
          {
            logo ? (
              <img class="brand__logo" src={logo} alt={storeName} />
            ) : (
              <span class="brand__name">{storeName}</span>
            )
          }
        </a>

        <div class="site-header__end">
          <nav class="nav nav--end" aria-label={t('global_nav_secondary_label')}>
            <a class="nav__link nav__link--account" href="/account"><T id="global_nav_account" /></a>
            <a class="nav__link" href="/cart" data-cart-open>
              <T id="global_nav_cart" /> <span class="nav__count" data-cart-count>(0)</span>
            </a>
          </nav>

          {
            /* data-edit-allow: in the editor this form submits on first
               change; switching language to edit it is not shopping. */
            localization && (
              <form
                class="loc"
                method="post"
                action="/localization"
                data-localization
                data-edit-allow
              >
                <input type="hidden" name="redirect_to" value={here} />
                {locales.length > 1 && (
                  <select
                    class="input"
                    name="locale"
                    aria-label={t('global_localization_language')}
                  >
                    {locales.map((option) => (
                      <option value={option.code} selected={option.code === locale}>
                        {option.name}
                      </option>
                    ))}
                  </select>
                )}
                {currencies.length > 1 && (
                  <select
                    class="input"
                    name="currency"
                    aria-label={t('global_localization_currency')}
                  >
                    {currencies.map((option) => (
                      <option value={option.code} selected={option.code === currency}>
                        {option.code}
                      </option>
                    ))}
                  </select>
                )}
                <button class="btn btn--small" type="submit" data-localization-apply>
                  <T id="global_localization_apply" />
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>

    <main class="site-main" id="main" data-flush={flush ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__mark">{storeName}</p>

        <nav class="site-footer__links" aria-label={t('global_footer_label')}>
          <a href="/"><T id="global_footer_shop" /></a>
          <a href="/account"><T id="global_footer_account" /></a>
          <a href="/cart"><T id="global_footer_cart" /></a>
          {supportEmail && <a href={`mailto:${supportEmail}`}><T id="global_footer_support" /></a>}
        </nav>

        {app.demo_mode === true && (
          <p class="site-footer__demo"><T id="demo_footer_notice" /></p>
        )}

        <p class="site-footer__legal">&copy; {new Date().getFullYear()}</p>
      </div>
    </footer>

    {/* Cart drawer. Opens optimistically on add-to-cart, before the request
        completes, then reconciles with the real cart. Without JS the forms
        it intercepts still post to /cart and land on the cart page. The
        data-t-* attributes carry the copy the script renders itself, so it
        comes from the same content panel as everything else. */}
    <div
      class="drawer"
      id="cart-drawer"
      hidden
      aria-hidden="true"
      data-t-adding={t('global_drawer_adding')}
      data-t-updating={t('global_drawer_updating')}
      data-t-removing={t('global_drawer_removing')}
      data-t-remove={t('global_drawer_remove')}
      data-t-qty={t('global_drawer_qty')}
      data-t-decrease={t('global_drawer_decrease')}
      data-t-increase={t('global_drawer_increase')}
      data-t-error={t('global_drawer_error')}
    >
      <div class="drawer__backdrop" data-drawer-close></div>
      <aside
        class="drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="drawer-title"
        data-drawer-panel
      >
        <header class="drawer__head">
          <h2 class="section__title" id="drawer-title">
            <T id="global_drawer_title" /> <span data-cart-count>(0)</span>
          </h2>
          <button
            class="drawer__close"
            type="button"
            data-drawer-close
            aria-label={t('global_drawer_close')}
          >
            &times;
          </button>
        </header>

        <p class="drawer__status meta" data-drawer-status aria-live="polite"></p>

        <ul class="drawer__lines" data-drawer-lines></ul>

        <div class="drawer__empty" data-drawer-empty hidden>
          <p class="lede"><T id="global_drawer_empty" /></p>
          <a class="btn" href="/" data-drawer-close><T id="global_drawer_browse" /></a>
        </div>

        <footer class="drawer__foot" data-drawer-foot hidden>
          <div class="summary__row summary__row--total">
            <span><T id="global_drawer_subtotal" /></span>
            <span data-drawer-subtotal>—</span>
          </div>
          <a class="btn btn--primary btn--block" href="/checkout" data-drawer-checkout>
            <T id="global_drawer_checkout" />
          </a>
          <a class="drawer__link" href="/cart"><T id="global_drawer_view_cart" /></a>
        </footer>
      </aside>
    </div>

    {
      /* The in-page copy editor: only on edit-mode renders, so a shopper's
         page carries none of it. It also holds every form here back until a
         second click on its button, which is what keeps the drawer from
         opening on a first click on an add-to-cart label while editing. */
      editMode && <EditClient />
    }

    <script>
      // The language and currency control applies on change. The Apply
      // button is the no-script path and goes away once this runs.
      const localization = document.querySelector<HTMLFormElement>('form[data-localization]');

      if (localization) {
        localization.querySelector<HTMLElement>('[data-localization-apply]')!.hidden = true;
        localization.addEventListener('change', () => localization.requestSubmit());
      }
    </script>

    <script>
      // Cart drawer and header count. Pages are cached and shared, so all
      // per-visitor state is fetched from /cart.json after load and every
      // change goes through POST /cart with an Accept: application/json.

      type Line = {
        id: string;
        name: string;
        slug: string | null;
        image: string | null;
        options: string;
        price: number;
        price_total: number;
        quantity: number;
        pending?: boolean;
      };

      type Cart = {
        item_quantity: number;
        sub_total: number;
        grand_total: number;
        currency: string | null;
        checkout_url: string | null;
        items: Line[];
      };

      const drawer = document.getElementById('cart-drawer');

      if (drawer) {
        setUp(drawer);
      }

      function setUp(drawer: HTMLElement) {
        const root = document.documentElement;
        const locale = root.dataset.locale || 'en-US';
        const fallbackCurrency = root.dataset.currency || 'USD';

        const panel = drawer.querySelector<HTMLElement>('[data-drawer-panel]')!;
        const lines = drawer.querySelector<HTMLElement>('[data-drawer-lines]')!;
        const empty = drawer.querySelector<HTMLElement>('[data-drawer-empty]')!;
        const foot = drawer.querySelector<HTMLElement>('[data-drawer-foot]')!;
        const status = drawer.querySelector<HTMLElement>('[data-drawer-status]')!;
        const subtotal = drawer.querySelector<HTMLElement>('[data-drawer-subtotal]')!;
        const checkout = drawer.querySelector<HTMLAnchorElement>('[data-drawer-checkout]')!;
        const counts = document.querySelectorAll<HTMLElement>('[data-cart-count]');

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        // The store's copy, rendered into data-t-* on the drawer by the layout.
        const copy = {
          adding: drawer.dataset.tAdding ?? '',
          updating: drawer.dataset.tUpdating ?? '',
          removing: drawer.dataset.tRemoving ?? '',
          remove: drawer.dataset.tRemove ?? '',
          qty: drawer.dataset.tQty ?? '',
          decrease: drawer.dataset.tDecrease ?? '',
          increase: drawer.dataset.tIncrease ?? '',
          error: drawer.dataset.tError ?? '',
        };

        let cart: Cart | null = null;
        let lastFocus: Element | null = null;
        let closeTimer = 0;

        // ---- rendering ------------------------------------------------

        function money(amount: number, currency: string | null): string {
          const code = currency || fallbackCurrency;
          try {
            return new Intl.NumberFormat(locale, {
              style: 'currency',
              currency: code,
            }).format(amount);
          } catch {
            return `${code} ${amount.toFixed(2)}`;
          }
        }

        function setCount(quantity: number) {
          counts.forEach((el) => {
            el.textContent = `(${quantity})`;
          });
        }

        function el<K extends keyof HTMLElementTagNameMap>(
          tag: K,
          className?: string,
          text?: string,
        ): HTMLElementTagNameMap[K] {
          const node = document.createElement(tag);
          if (className) node.className = className;
          if (text !== undefined) node.textContent = text;
          return node;
        }

        function render(next: Cart, message = '') {
          status.textContent = message;
          setCount(next.item_quantity);

          lines.replaceChildren(...next.items.map(renderLine.bind(null, next)));

          const hasItems = next.items.length > 0;
          empty.hidden = hasItems;
          foot.hidden = !hasItems;
          subtotal.textContent = money(next.sub_total, next.currency);
          checkout.href = '/checkout';
        }

        function renderLine(next: Cart, line: Line): HTMLElement {
          const item = el('li', 'drawer__line' + (line.pending ? ' is-pending' : ''));

          // Eager, not lazy: the drawer holds a handful of thumbnails and they
          // are all in view the moment it opens.
          const media = el('div', 'line__media');
          if (line.image) {
            const img = el('img');
            img.src = line.image;
            img.alt = '';
            media.append(img);
          }

          const body = el('div', 'drawer__body');
          const name = el('a', 'drawer__name', line.name);
          name.href = line.slug ? `/products/${line.slug}` : '/cart';
          body.append(name);

          if (line.options) {
            body.append(el('p', 'line__opts', line.options));
          }

          const controls = el('div', 'drawer__controls');

          if (line.pending) {
            controls.append(el('span', 'line__opts', `${copy.qty} ${line.quantity}`));
          } else {
            const qty = el('div', 'drawer__qty');
            const minus = el('button', 'drawer__step', '−');
            minus.type = 'button';
            minus.setAttribute('aria-label', copy.decrease);
            const value = el('span', 'drawer__value', String(line.quantity));
            const plus = el('button', 'drawer__step', '+');
            plus.type = 'button';
            plus.setAttribute('aria-label', copy.increase);

            minus.addEventListener('click', () => change(line, line.quantity - 1));
            plus.addEventListener('click', () => change(line, line.quantity + 1));
            qty.append(minus, value, plus);

            const remove = el('button', 'linkbtn', copy.remove);
            remove.type = 'button';
            remove.addEventListener('click', () => change(line, 0));

            controls.append(qty, remove);
          }

          body.append(controls);

          const total = el('div', 'line__total', money(line.price_total, next.currency));

          item.append(media, body, total);
          return item;
        }

        // ---- data ---------------------------------------------------------

        async function load(): Promise<Cart | null> {
          try {
            const res = await fetch('/cart.json', { credentials: 'same-origin' });
            const data = await res.json();
            cart = data.cart;
            if (cart) render(cart);
            return cart;
          } catch {
            return null;
          }
        }

        // Writes run one at a time. Two quick stepper clicks would otherwise
        // race, and whichever response landed last would win the render.
        let queue: Promise<unknown> = Promise.resolve();

        function post(form: FormData): Promise<Cart> {
          const run = queue.then(() => send(form));
          queue = run.catch(() => undefined);
          return run;
        }

        async function send(form: FormData): Promise<Cart> {
          const res = await fetch('/cart', {
            method: 'POST',
            body: form,
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok || data.error) {
            throw new Error(data.error || copy.error);
          }

          cart = data.cart;
          return data.cart;
        }

        // Quantity changes from inside the drawer are optimistic too: the
        // line updates instantly, then settles on whatever the server says.
        async function change(line: Line, quantity: number) {
          if (!cart) return;

          const before = cart;
          const items = cart.items
            .map((item) =>
              item.id === line.id
                ? {
                    ...item,
                    quantity,
                    price_total: item.price * quantity,
                    pending: true,
                  }
                : item,
            )
            .filter((item) => item.quantity > 0);

          render(recalc({ ...cart, items }), quantity > 0 ? copy.updating : copy.removing);

          const form = new FormData();
          form.set('action', quantity > 0 ? 'update' : 'remove');
          form.set('item_id', line.id);
          form.set('quantity', String(quantity));

          try {
            render(await post(form));
          } catch (err) {
            cart = before;
            render(before, (err as Error).message);
          }
        }

        function recalc(next: Cart): Cart {
          const sub_total = next.items.reduce((sum, item) => sum + item.price_total, 0);
          const item_quantity = next.items.reduce((sum, item) => sum + item.quantity, 0);
          return { ...next, sub_total, item_quantity };
        }

        function emptyCart(): Cart {
          return {
            item_quantity: 0,
            sub_total: 0,
            grand_total: 0,
            currency: fallbackCurrency,
            checkout_url: null,
            items: [],
          };
        }

        // ---- add to cart, optimistically ----------------------------------

        document.addEventListener('submit', (event) => {
          const form = event.target as HTMLFormElement;
          if (!form.matches('form[data-cart-form]')) return;

          event.preventDefault();

          const data = new FormData(form);
          const quantity = Math.max(1, Math.floor(Number(data.get('quantity')) || 1));

          // What the shopper answered, read off the controls themselves so the
          // drawer can name it and price it before the server replies. Every
          // option's price is a delta on the product's own; the API adds the
          // same amounts, so the pending line matches the one that replaces it.
          const chosen: string[] = [];
          let price = Number(form.dataset.price) || 0;
          let image = form.dataset.image || null;

          form
            .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
              '[name^="options["]',
            )
            .forEach((control) => {
              const field = control.closest<HTMLElement>('[data-option]');
              if (field?.hidden) return;

              const picked =
                control instanceof HTMLSelectElement ? control.selectedOptions[0] : control;

              if (control instanceof HTMLInputElement && control.type === 'checkbox') {
                if (!control.checked) return;
              } else if (!control.value.trim()) {
                return;
              }

              const label =
                picked instanceof HTMLOptionElement
                  ? picked.dataset.label || picked.textContent?.trim() || ''
                  : control.dataset.label || control.value.trim();

              // Same rules as optionsOf and lineImage in lib/cart-json.ts: a
              // variant option is its value alone, a ticked toggle its name
              // alone, anything else is named; a value with a photo is the
              // line's picture. Matching them is what stops the line
              // rewriting itself on the reply.
              const name = field?.querySelector('.field__label span')?.textContent?.trim();
              const toggle = control instanceof HTMLInputElement && control.type === 'checkbox';
              const named = name && !field?.hasAttribute('data-option-variant');
              chosen.push(named ? (toggle ? name : `${name}: ${label}`) : label);
              price += Number(picked.dataset.price) || 0;
              if (picked.dataset.image) image = picked.dataset.image;
            });

          const optimistic: Line = {
            id: `pending-${Date.now()}`,
            name: form.dataset.name || '',
            slug: form.dataset.slug || null,
            image,
            options: chosen.join(' · '),
            price,
            price_total: price * quantity,
            quantity,
            pending: true,
          };

          const before = cart ?? emptyCart();
          render(
            recalc({ ...before, items: [optimistic, ...before.items] }),
            copy.adding,
          );
          open();

          post(data).then(
            (next) => render(next),
            (err) => {
              cart = before;
              render(before, (err as Error).message);
            },
          );
        });

        // ---- open / close -------------------------------------------------

        function open() {
          window.clearTimeout(closeTimer);
          lastFocus = document.activeElement;
          drawer.hidden = false;
          drawer.setAttribute('aria-hidden', 'false');
          document.body.classList.add('drawer-open');
          // Force a layout between un-hiding and opening so the slide-in has a
          // starting state. A reflow is synchronous; requestAnimationFrame is
          // not, and never fires at all in a background tab.
          void drawer.offsetWidth;
          drawer.classList.add('is-open');
          // The close *button* — the backdrop carries the same data attribute
          // but a div cannot take focus.
          drawer.querySelector<HTMLElement>('.drawer__close')?.focus();
        }

        function close() {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-open');

          const finish = () => {
            drawer.hidden = true;
          };
          closeTimer = window.setTimeout(finish, reduced.matches ? 0 : 260);

          if (lastFocus instanceof HTMLElement) lastFocus.focus();
        }

        drawer.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('[data-drawer-close]')) {
            close();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (drawer.hidden) return;

          if (event.key === 'Escape') {
            close();
            return;
          }

          // Keep Tab inside the dialog while it is open.
          if (event.key === 'Tab') {
            const focusable = panel.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input, select, [tabindex]:not([tabindex="-1"])',
            );
            if (focusable.length === 0) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        document.querySelectorAll<HTMLAnchorElement>('[data-cart-open]').forEach((link) => {
          link.addEventListener('click', (event) => {
            event.preventDefault();
            if (!cart) load();
            open();
          });
        });

        load();
      }
    </script>
  </body>
</html>

<style is:global>
  /* Every rule for the shop lives here. Components use these classes rather
     than carrying their own styles. */

  :root {
    /* Merchant palette, dark by default. The inline style on <html> overrides
       only what the merchant set, so an unconfigured store still looks
       designed. Defaults mirror settings/outfitter.json — change both. */
    --color-primary: #f0f0f0;
    --color-secondary: #0f0f0f;
    --color-text: #f0f0f0;
    --color-muted: #9e9e9e;
    --color-background: #0f0f0f;
    --color-surface: #181818;
    --color-border: #3f3f3f;

    /* Native controls, scrollbars and the select chevron follow the palette. */
    color-scheme: dark;

    --font-sans:
      'Archivo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
      Arial, sans-serif;
    --font-mono:
      'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    /* Sizes are small and tracking is positive on everything below 1rem —
       that ratio is what reads as considered rather than templated. */
    --text-chrome: 0.6875rem;
    --text-nav: 0.8125rem;
    --text-meta: 0.75rem;
    --text-body: 0.875rem;
    --text-lede: 1rem;
    --text-h2: 1.75rem;
    --text-h1: 2rem;
    --text-display: clamp(2.25rem, 5vw, 3.5rem);

    --track-chrome: 0.14em;
    --track-wide: 0.05em;

    --container: 1400px;
    --pad: 1.5rem;
    --gutter: 1.5rem;
    --row-gap: 2.5rem;
    --section: 5rem;
    --header-h: 64px;
    --prose: 34rem;

    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --dur-ui: 150ms;
    --dur-media: 400ms;
  }

  @media (max-width: 767px) {
    :root {
      --section: 3rem;
      --row-gap: 2rem;
      --gutter: 1rem;
    }
  }

  @media (max-width: 479px) {
    :root {
      --pad: 1.25rem;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    /* Full-bleed sections are laid out against 100vw, which includes the
       scrollbar gutter; clip rather than scroll. `clip` (not `hidden`) does
       not make the viewport a scroll container, so the sticky header holds. */
    overflow-x: clip;
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.6;
    letter-spacing: var(--track-wide);
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* An author `display` on a class would otherwise beat the attribute — the
     drawer toggles its empty state and footer with `hidden`. */
  [hidden] {
    display: none !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Links underline rather than change color — the palette stays monochrome
     and the product supplies the color. */
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 500;
  }

  p {
    margin: 0;
  }

  ::selection {
    background: var(--color-primary);
    color: var(--color-secondary);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-primary);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-chrome);
    letter-spacing: var(--track-chrome);
    text-transform: uppercase;
  }

  .skip-link:focus {
    left: 0;
  }

  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad);
  }

  /* Header ------------------------------------------------------------ */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-background);
  }

  .site-header__inner {
    display: grid;
