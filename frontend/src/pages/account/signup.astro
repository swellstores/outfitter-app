---
import Layout from '@/layouts/Layout.astro';
import T from '@/components/T.astro';

const { swell, account, t } = Astro.locals;

if (account) {
  return Astro.redirect('/account', 303);
}

// The id of the error to show, so the sentence itself is editable copy.
let error = '';
let email = '';
let firstName = '';
let lastName = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  email = String(form.get('email') ?? '');
  firstName = String(form.get('first_name') ?? '');
  lastName = String(form.get('last_name') ?? '');

  const password = String(form.get('password') ?? '');

  const created = await swell.storefront.account
    .create({
      email,
      password,
      first_name: firstName,
      last_name: lastName,
    })
    .catch(() => null);

  if (created && !('errors' in created)) {
    // create() does not always leave a session behind, so sign in explicitly.
    await swell.storefront.account.login(email, password).catch(() => null);

    return Astro.redirect('/account', 303);
  }

  error = 'account_signup_error';
}
---

<Layout title={t('account_signup_title')}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow"><T id="account_signup_eyebrow" /></p>
      <h1 class="display"><T id="account_signup_title" /></h1>
    </header>

    <div class="narrow">
      {error && <p class="error"><T id={error} /></p>}

      <form method="post">
        <label class="field">
          <span class="field__label"><T id="account_signup_first_name" /></span>
          <input
            class="input"
            type="text"
            name="first_name"
            value={firstName}
            autocomplete="given-name"
          />
        </label>

        <label class="field">
          <span class="field__label"><T id="account_signup_last_name" /></span>
          <input
            class="input"
            type="text"
            name="last_name"
            value={lastName}
            autocomplete="family-name"
          />
        </label>

        <label class="field">
          <span class="field__label"><T id="account_signup_email" /></span>
          <input
            class="input"
            type="email"
            name="email"
            value={email}
            autocomplete="email"
            required
          />
        </label>

        <label class="field">
          <span class="field__label"><T id="account_signup_password" /></span>
          <input
            class="input"
            type="password"
            name="password"
            autocomplete="new-password"
            required
          />
        </label>

        <button class="btn btn--primary btn--block" type="submit">
          <T id="account_signup_submit" />
        </button>
      </form>

      <p class="form-links">
        <a href="/account/login"><T id="account_signup_login_link" /></a>
      </p>
    </div>
  </div>
</Layout>
