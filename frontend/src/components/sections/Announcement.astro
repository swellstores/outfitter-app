---
import T from '@/components/T.astro';
import type { Section } from '@/lib/sections';

/**
 * One line in a slim strip — a shipping threshold or a drop date — with an
 * optional link. An empty link is left out of a shopper's page; in edit mode
 * it stays, empty, so a label typed into the editor's rail shows up without
 * a reload.
 */
interface Props {
  section: Section;
}

const { section } = Astro.props;
const { editMode } = Astro.locals;
---

<section class="sec sec--announcement" data-section={section.id} data-section-type="announcement">
  <p class="sec__line"><T id={`sec:${section.id}:heading`} value={section.heading} /></p>
  {(section.cta_label || editMode) && (
    <a class="sec__link" href={section.cta_url || '/'}>
      <T id={`sec:${section.id}:cta_label`} value={section.cta_label} />
    </a>
  )}
</section>
