---
import T from '@/components/T.astro';
import { srcset, WIDE_WIDTHS } from '@/lib/image';
import type { Section } from '@/lib/sections';

/**
 * A wide picture with a heading, a line and a button laid over it. The
 * picture is decorative — the copy on top carries the meaning — and with no
 * picture saved the copy sits on the surface tint alone. Empty lines are
 * left out of a shopper's page; in edit mode they stay, empty, so copy typed
 * into the editor's rail shows up without a reload.
 */
interface Props {
  section: Section;
}

const { section } = Astro.props;
const { editMode } = Astro.locals;
---

<section class="sec sec--image-banner" data-section={section.id} data-section-type="image_banner">
  <div class="sec__media sec__media--wide">
    {/* Not lazy: a banner is usually the first picture on the page, and a
        lazy one is only fetched after layout, so it would arrive last. Under
        900px a wide banner is cropped to a square, which shows the picture at
        well over the screen's width; the sizes say so, or it would blur. */}
    {section.image && (
      <img
        src={section.image}
        srcset={srcset(section.image, WIDE_WIDTHS)}
        sizes="(min-width: 1400px) 1352px, (min-width: 900px) 100vw, 240vw"
        alt=""
      />
    )}

    <div class="sec__overlay">
      {(section.eyebrow || editMode) && (
        <p class="eyebrow"><T id={`sec:${section.id}:eyebrow`} value={section.eyebrow} /></p>
      )}
      {(section.heading || editMode) && (
        <h2 class="title"><T id={`sec:${section.id}:heading`} value={section.heading} /></h2>
      )}
      {(section.body || editMode) && (
        <p class="lede"><T id={`sec:${section.id}:body`} value={section.body} /></p>
      )}
      {(section.cta_label || editMode) && (
        <a class="btn btn--primary" href={section.cta_url || '/'}>
          <T id={`sec:${section.id}:cta_label`} value={section.cta_label} />
        </a>
      )}
    </div>
  </div>
</section>
