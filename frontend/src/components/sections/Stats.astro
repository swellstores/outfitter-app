---
import T from '@/components/T.astro';
import type { Section } from '@/lib/sections';

/**
 * Up to four big figures with a label under each. A slot with neither a
 * figure nor a label is left out of a shopper's page; in edit mode it stays,
 * empty, so a figure typed into the editor's rail shows up without a reload.
 */
interface Props {
  section: Section;
}

const { section } = Astro.props;
const { editMode } = Astro.locals;

// The four slots, each a figure over its label.
const slots = [
  { figure: 'title_a', label: 'text_a' },
  { figure: 'title_b', label: 'text_b' },
  { figure: 'title_c', label: 'text_c' },
  { figure: 'title_d', label: 'text_d' },
] as const;
---

<section class="sec sec--stats" data-section={section.id} data-section-type="stats">
  <div class="sec__lead">
    {(section.eyebrow || editMode) && (
      <p class="eyebrow"><T id={`sec:${section.id}:eyebrow`} value={section.eyebrow} /></p>
    )}
    <h2 class="title"><T id={`sec:${section.id}:heading`} value={section.heading} /></h2>
  </div>

  <dl class="sec__grid sec__grid--four">
    {slots.map(({ figure, label }) =>
      (section[figure] || section[label] || editMode) && (
        <div class="sec__item sec__stat">
          <dt class="sec__figure"><T id={`sec:${section.id}:${figure}`} value={section[figure]} /></dt>
          <dd class="eyebrow"><T id={`sec:${section.id}:${label}`} value={section[label]} /></dd>
        </div>
      )
    )}
  </dl>
</section>
